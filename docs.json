{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "FleetPoint",
  "colors": {
    "primary": "#263fe2",
    "light": "#263fe2",
    "dark": "#263fe2"
  },
  "background": {
    "decoration": "grid"
  },
  "styling": {
    "codeblocks": {
      "theme": "github-dark"
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart",
          "connect",
          "plans",
          "roles"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/handle-breakdowns",
          "guides/set-up-inspections",
          "guides/lay-out-your-map"
        ]
      },
      {
        "group": "Company",
        "pages": [
          "company/overview",
          "company/subscriptions",
          "company/partner-program",
          "company/active"
        ]
      },
      {
        "group": "Fleet",
        "pages": [
          "fleet/manage-fleet",
          "fleet/buses",
          "fleet/activity-logs",
          "fleet/replay",
          "fleet/fleet-health",
          "fleet/inspections",
          "fleet/maintenance-logs"
        ]
      },
      {
        "group": "Maps",
        "pages": [
          "maps/manage-maps",
          "maps/live-map",
          "maps/lots",
          "maps/routes"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Features",
          "href": "https://fleetpointapp.com/features",
          "icon": "book-open-cover"
        }
      ]
    }
  },
  "logo": {
    "light": "https://fleetpointapp.com/assets/images/brand.png",
    "dark": "https://fleetpointapp.com/assets/images/brand-white.png",
    "href": "https://fleetpointapp.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://fleetpointapp.com/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://fleetpointapp.com/companies"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://fleetpointapp.com/support",
      "github": "https://github.com/FleetPoint/fleetpoint-docs"
    }
  },
  "banner": {
    "content": "FleetPoint is a new service, and documentation may change!",
    "type": "info"
  },
  "errors": {
    "404": {
      "redirect": false
    }
  }
}
